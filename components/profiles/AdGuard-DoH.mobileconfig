<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerAddresses</key>
                <array>
                    <string>94.140.14.140</string>
                    <string>94.140.14.141</string>
                </array>
                <key>ServerURL</key>
                <string>https://dns.adguard-dns.com/dns-query</string>
            </dict>
            <key>PayloadDescription</key>
            <string>Configures AdGuard DNS-over-HTTPS for ECH support in Safari and WebKit apps</string>
            <key>PayloadDisplayName</key>
            <string>AdGuard DoH (ECH)</string>
            <key>PayloadIdentifier</key>
            <string>com.will.dns.adguard-doh</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>ProhibitDisablement</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Enables AdGuard DNS-over-HTTPS so Safari and WebKit apps can fetch HTTPS DNS records required for ECH (Encrypted Client Hello)</string>
    <key>PayloadDisplayName</key>
    <string>AdGuard DoH for ECH</string>
    <key>PayloadIdentifier</key>
    <string>com.will.dns.adguard-doh.profile</string>
    <key>PayloadOrganization</key>
    <string>Will</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B2C3D4E5-F6A7-8901-BCDE-F12345678901</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
